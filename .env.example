BOT_TOKEN=123456:replace_with_real_token
DATABASE_URL=sqlite+aiosqlite:///./dev.db
REDIS_URL=redis://localhost:6379/0

USE_POLLING=true

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

RATE_LIMIT_USER_PER_MINUTE=5
RATE_LIMIT_CHAT_PER_MINUTE=20
SPAM_DEDUP_WINDOW_SECONDS=300
MAX_FILE_SIZE_MB=500
SEND_VIDEO_LIMIT_MB=50
SEND_DOCUMENT_LIMIT_MB=100

SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_API_TIMEOUT_SECONDS=10
SPOTIFY_DOWNLOAD_ENABLED=true
SPOTIFY_DL_TIMEOUT_SECONDS=600
SPOTIFY_DL_OUTPUT_FORMAT=mp3
