BOT_TOKEN=replace_with_telegram_bot_token
PINTEREST_BOT_TOKEN=replace_with_pinterest_telegram_bot_token
DATABASE_URL=postgresql+asyncpg://saveinator:saveinator@localhost:5432/saveinator
DB_PASSWORD=replace_with_app_db_password
REDIS_URL=redis://localhost:6379/0

# Go binary mode: all | bot | worker (see go/README.md)
SAVEINATOR_MODE=all

# Production uses Telegram webhook mode. For local polling, run with USE_POLLING=true.
USE_POLLING=false
WEBHOOK_HOST=https://saveinator-hooks.example.com
WEBHOOK_PATH=/webhook
WEBHOOK_PORT=8000
WEBHOOK_LISTEN=0.0.0.0
WEBHOOK_SECRET_TOKEN=

METRICS_ENABLED=true
METRICS_PORT=9101
WORKER_METRICS_PORT=9102

RATE_LIMIT_USER_PER_MINUTE=5
RATE_LIMIT_CHAT_PER_MINUTE=20
SPAM_DEDUP_WINDOW_SECONDS=300
MAX_FILE_SIZE_MB=500
SEND_VIDEO_LIMIT_MB=50
SEND_DOCUMENT_LIMIT_MB=1999
DOWNLOAD_TIMEOUT_SECONDS=60
YOUTUBE_MAX_FILE_SIZE_MB=1999
YOUTUBE_DOWNLOAD_TIMEOUT_SECONDS=600
YOUTUBE_TRANSCODE_ENABLED=true
YOUTUBE_COMPRESS_LONG_ENABLED=true
YOUTUBE_COMPRESS_MIN_DURATION_SEC=600

SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_API_TIMEOUT_SECONDS=15
SPOTIFY_DOWNLOAD_ENABLED=true
SPOTIFY_TRACK_TIMEOUT_SECONDS=60
SPOTIFY_DL_OUTPUT_FORMAT=mp3
SPOTIFY_LOCK_MAX_TRACKS=50
SPOTIFY_DOWNLOAD_CONCURRENCY=2
SPOTIFY_META_CACHE_TTL_SECONDS=3600
YOUTUBE_SEARCH_CACHE_TTL_SECONDS=604800

SOUNDCLOUD_ENABLED=true
SOUNDCLOUD_DOWNLOAD_ENABLED=false
SOUNDCLOUD_TRACK_TIMEOUT_SECONDS=30
SOUNDCLOUD_MAX_TRACKS=20
SOUNDCLOUD_DL_OUTPUT_FORMAT=mp3
SOUNDCLOUD_MAX_FILE_MB=50
SOUNDCLOUD_META_CACHE_TTL_SECONDS=3600

# Yandex Music (metadata via api.music.yandex.net; audio is sourced from YouTube).
# The API answers 451 to unauthenticated requests from non-CIS IPs — an OAuth
# token is required for deployments outside RU/CIS.
#
# Get a token with the Device Flow helper (uses public Android-app credentials):
#   python3 scripts/get-yandex-music-token.py
# It prints a confirmation link + code, waits for you to approve, then prints
# access_token and validates it against api.music.yandex.net.
#
# Browser fallback (implicit OAuth): open
#   https://oauth.yandex.ru/authorize?response_type=token&client_id=23cabbbdc6cd418abb4b39c32c41195d
# approve access, then copy access_token from the fast redirect to a
# music.yandex.ru/#access_token=... URL (throttle network in DevTools to catch it).
# Auto-enables the platform when set.
YANDEX_MUSIC_ENABLED=false
YANDEX_MUSIC_ACCESS_TOKEN=
YANDEX_MUSIC_API_TIMEOUT_SECONDS=15
YANDEX_MUSIC_DOWNLOAD_ENABLED=true
YANDEX_MUSIC_TRACK_TIMEOUT_SECONDS=60
YANDEX_MUSIC_DL_OUTPUT_FORMAT=mp3
YANDEX_MUSIC_LOCK_MAX_TRACKS=50
YANDEX_MUSIC_DOWNLOAD_CONCURRENCY=2

PINTEREST_ENABLED=true
PINTEREST_TIMEOUT_SECONDS=30
PINTEREST_MAX_ITEMS=10
PINTEREST_DOWNLOAD_IMAGES=true
PINTEREST_DOWNLOAD_VIDEOS=true
PINTEREST_COOKIES_PATH=

# ---- Instagram (main bot, via yt-dlp) ----
INSTAGRAM_ENABLED=true
INSTAGRAM_DOWNLOAD_TIMEOUT_SECONDS=60
INSTAGRAM_MAX_FILE_SIZE_MB=50
INSTAGRAM_COOKIES_PATH=
INSTAGRAM_COOKIES_FROM_BROWSER=
# Optional watermark handle (without @); auto-detected via getMe if empty
PINTEREST_BOT_USERNAME=
# ---- Spotify (separate Telegram bot, @spotify_search_tool_bot) ----
SPOTIFY_BOT_TOKEN=replace_with_spotify_bot_token
# Optional watermark handle (without @); auto-detected via getMe if empty
SPOTIFY_BOT_USERNAME=spotify_search_tool_bot
SPOTIFY_ENABLED=true
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_API_TIMEOUT_SECONDS=15
SPOTIFY_DOWNLOAD_ENABLED=true
SPOTIFY_TRACK_TIMEOUT_SECONDS=60
SPOTIFY_DL_OUTPUT_FORMAT=mp3
SPOTIFY_LOCK_MAX_TRACKS=50
SPOTIFY_DOWNLOAD_CONCURRENCY=2
# ---- SoundCloud (separate Telegram bot) ----
SOUNDCLOUD_BOT_TOKEN=replace_with_soundcloud_bot_token
SOUNDCLOUD_ENABLED=true
SOUNDCLOUD_DOWNLOAD_ENABLED=true
SOUNDCLOUD_TRACK_TIMEOUT_SECONDS=30
SOUNDCLOUD_MAX_TRACKS=100
SOUNDCLOUD_DL_OUTPUT_FORMAT=mp3
SOUNDCLOUD_DOWNLOAD_CONCURRENCY=1
# ---- Pinterest KZ (Kazakh) bot (separate Telegram bot) ----
PINTEREST_KZ_BOT_TOKEN=replace_with_pinterest_kz_bot_token
# Optional watermark handle (without @); auto-detected via getMe if empty
PINTEREST_KZ_BOT_USERNAME=
PINTEREST_KZ_ENABLED=true
PINTEREST_KZ_TIMEOUT_SECONDS=30
PINTEREST_KZ_MAX_ITEMS=10
PINTEREST_KZ_DOWNLOAD_IMAGES=true
PINTEREST_KZ_DOWNLOAD_VIDEOS=true
PINTEREST_KZ_COOKIES_PATH=
# ---- botd (multi-bot runtime; bots defined in bots.yaml) ----
# BOTD_WEBHOOK_PORT=8005
# BOTD_WEBHOOK_HOST=https://saveinator-hooks.example.com
# BOTD_USE_POLLING=false
# BOTS_CONFIG=bots.yaml
TIKTOK_COOKIES_PATH=
TIKTOK_COOKIES_FROM_BROWSER=chrome
TIKTOK_COOKIES_REFRESH_ENABLED=true
TIKTOK_COOKIES_REFRESH_URL=https://vt.tiktok.com/ZSCFGyN3g/
TIKTOK_REFERER=https://www.tiktok.com/
TIKTOK_MAX_DURATION_SEC=0
DOWNLOAD_API_ENABLED=true
# Required when DOWNLOAD_API_ENABLED=true. Shared secret checked against the
# X-Internal-Token header on internal-only HTTP download endpoints (e.g.
# /download/pinterest). Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=
INTERNAL_API_RATE_PER_MINUTE=10

ADMIN_TELEGRAM_ID=0

# ---- dash (operator dashboard) ----
# Bot for the Telegram Login Widget (defaults to BOT_TOKEN) and the
# comma-separated allowlist of Telegram ids allowed to log in.
DASH_TELEGRAM_TOKEN=
DASH_ADMIN_IDS=339193247
