# Grafana admin credentials (required)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_long_random_password

# Same password as the app stack .env (for postgres_exporter)
DB_PASSWORD=replace_with_app_db_password

# Optional: webhook URL for Alertmanager (leave unset to use default receiver)
# ALERT_WEBHOOK_URL=https://example.com/alerts
