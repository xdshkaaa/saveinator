:8092 {
	reverse_proxy 127.0.0.1:3000

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}

	log {
		output file /var/log/caddy/saveinator.xdshka.party.access.log
		format console
	}
}

:8093 {
	@pinterest_hooks path /webhook/pinterest /download/pinterest
	handle @pinterest_hooks {
		reverse_proxy 127.0.0.1:8001
	}

	@pinterest_kz_hooks path /webhook/pinterest_kz /download/pinterest_kz
	handle @pinterest_kz_hooks {
		reverse_proxy 127.0.0.1:8002
	}

	@spotify_hooks path /webhook/spotify
	handle @spotify_hooks {
		reverse_proxy 127.0.0.1:8003
	}

	@telegram_hooks path / /health /webhook*
	handle @telegram_hooks {
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		respond 404
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}

	log {
		output file /var/log/caddy/saveinator-hooks.xdshka.party.access.log
		format console
	}
}
