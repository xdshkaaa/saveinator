{
  "uid": "saveinator-user-activity",
  "title": "User Activity",
  "tags": ["saveinator", "users"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {"id": 1, "type": "timeseries", "title": "New Users per Day", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"expr": "increase(saveinator_users_created_total[1d])", "legendFormat": "new users", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 2, "type": "timeseries", "title": "Active Users per Hour", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "targets": [{"expr": "increase(saveinator_messages_received_total[1h])", "legendFormat": "active message events", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 3, "type": "timeseries", "title": "Active Users per Day", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "targets": [{"expr": "increase(saveinator_messages_received_total[1d])", "legendFormat": "daily message events", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 4, "type": "logs", "title": "Messages by Chat Type", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "targets": [{"expr": "{service=~\"bot|webhook\", container=~\"saveinator.*\"} |~ \"private|group|supergroup\"", "refId": "A", "datasource": {"type": "loki", "uid": "loki"}}], "options": {"showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending"}},
    {"id": 5, "type": "bargauge", "title": "Most Used Commands", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}, "targets": [{"expr": "topk(15, sum by (command) (increase(saveinator_commands_handled_total[$__range])))", "legendFormat": "{{command}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 6, "type": "logs", "title": "Language Distribution", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}, "targets": [{"expr": "{container=~\"saveinator.*\"} |~ \"lang|language|locale\"", "refId": "A", "datasource": {"type": "loki", "uid": "loki"}}], "options": {"showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending"}},
    {"id": 7, "type": "logs", "title": "Onboarding Starts", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 24}, "targets": [{"expr": "{container=~\"saveinator.*\"} |~ \"onboarding.*start|start command\"", "refId": "A", "datasource": {"type": "loki", "uid": "loki"}}], "options": {"showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending"}},
    {"id": 8, "type": "logs", "title": "Onboarding Completions", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 24}, "targets": [{"expr": "{container=~\"saveinator.*\"} |~ \"onboarding.*complete|onboarding.*done\"", "refId": "A", "datasource": {"type": "loki", "uid": "loki"}}], "options": {"showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending"}},
    {"id": 9, "type": "logs", "title": "Settings Usage", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 24}, "targets": [{"expr": "{container=~\"saveinator.*\"} |~ \"settings|runtime_settings|admin\"", "refId": "A", "datasource": {"type": "loki", "uid": "loki"}}], "options": {"showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending"}},
    {"id": 10, "type": "logs", "title": "Banned User Messages", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 32}, "targets": [{"expr": "{container=~\"saveinator.*\"} |~ \"banned|ban\"", "refId": "A", "datasource": {"type": "loki", "uid": "loki"}}], "options": {"showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending"}},
    {"id": 11, "type": "timeseries", "title": "Rate Limit Events", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 32}, "targets": [{"expr": "sum by (scope) (rate(saveinator_rate_limit_dropped_total[$__rate_interval]) * 60)", "legendFormat": "{{scope}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 12, "type": "timeseries", "title": "Spam Middleware Events", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 32}, "targets": [{"expr": "sum by (reason) (rate(saveinator_spam_blocked_total[$__rate_interval]) * 60)", "legendFormat": "{{reason}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]}
  ]
}
