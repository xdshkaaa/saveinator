{
  "uid": "saveinator-reliability-errors",
  "title": "Error & Reliability",
  "tags": ["saveinator", "errors", "reliability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Total Errors by Source", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"expr": "sum by (source) (rate(saveinator_errors_total[$__rate_interval]) * 60)", "legendFormat": "{{source}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 2, "type": "logs", "title": "Errors by Handler", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "targets": [{"expr": "{container=~\"saveinator.*\"} |~ \"handler|Handler\" |~ \"error|failed|exception\"", "refId": "A", "datasource": {"type": "loki", "uid": "loki"}}], "options": {"showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending"}},
    {"id": 3, "type": "timeseries", "title": "Errors by Platform", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "targets": [{"expr": "sum by (platform) (rate(saveinator_ytdlp_errors_total[$__rate_interval]) * 60)", "legendFormat": "{{platform}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 4, "type": "timeseries", "title": "Telegram API Error Rate", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "targets": [{"expr": "rate(saveinator_telegram_api_failures_total[$__rate_interval]) * 60", "legendFormat": "failures/min", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 5, "type": "logs", "title": "Database Errors", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16}, "targets": [{"expr": "{container=~\"saveinator.*\"} |~ \"database|postgres|sqlalchemy|asyncpg\" |~ \"error|failed|exception\"", "refId": "A", "datasource": {"type": "loki", "uid": "loki"}}], "options": {"showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending"}},
    {"id": 6, "type": "logs", "title": "Redis Errors", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16}, "targets": [{"expr": "{container=~\"saveinator.*\"} |= \"redis\" |~ \"error|failed|exception|timeout\"", "refId": "A", "datasource": {"type": "loki", "uid": "loki"}}], "options": {"showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending"}},
    {"id": 7, "type": "logs", "title": "Worker Task Errors", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16}, "targets": [{"expr": "{service=~\"worker\", container=~\"saveinator.*\"} |~ \"failed|exception|error\"", "refId": "A", "datasource": {"type": "loki", "uid": "loki"}}], "options": {"showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending"}},
    {"id": 8, "type": "logs", "title": "Unhandled Exceptions", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 24}, "targets": [{"expr": "{container=~\"saveinator.*\"} |~ \"Traceback|Unhandled|exception\"", "refId": "A", "datasource": {"type": "loki", "uid": "loki"}}], "options": {"showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending"}},
    {"id": 9, "type": "logs", "title": "Warning Logs", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 24}, "targets": [{"expr": "{container=~\"saveinator.*\"} |~ \"warning|WARN|WARNING\"", "refId": "A", "datasource": {"type": "loki", "uid": "loki"}}], "options": {"showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending"}},
    {"id": 10, "type": "logs", "title": "Error Logs", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 24}, "targets": [{"expr": "{container=~\"saveinator.*\"} |~ \"error|ERROR|failed|exception\"", "refId": "A", "datasource": {"type": "loki", "uid": "loki"}}], "options": {"showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending"}},
    {"id": 11, "type": "logs", "title": "Top Recurring Error Messages", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 32}, "targets": [{"expr": "topk(20, sum by (container) (count_over_time({container=~\"saveinator.*\"} |~ \"error|ERROR|failed|exception\" [$__interval])))", "refId": "A", "datasource": {"type": "loki", "uid": "loki"}}]}
  ]
}
