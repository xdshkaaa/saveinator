{
  "uid": "saveinator-data-stores",
  "title": "PostgreSQL & Redis",
  "tags": ["saveinator", "postgres", "redis"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {"id": 1, "type": "stat", "title": "PostgreSQL Availability", "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}, "targets": [{"expr": "pg_up", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 2, "type": "timeseries", "title": "Active Connections", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}, "targets": [{"expr": "sum by (datname, state) (pg_stat_activity_count)", "legendFormat": "{{datname}} {{state}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 3, "type": "timeseries", "title": "Slow Queries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}, "targets": [{"expr": "max by (datname) (pg_stat_activity_max_tx_duration)", "legendFormat": "{{datname}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 4, "type": "timeseries", "title": "Transaction Rate", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}, "targets": [{"expr": "sum by (datname) (rate(pg_stat_database_xact_commit[$__rate_interval]) + rate(pg_stat_database_xact_rollback[$__rate_interval]))", "legendFormat": "{{datname}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 5, "type": "timeseries", "title": "Table Size Growth", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}, "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}, "targets": [{"expr": "pg_total_relation_size_bytes", "legendFormat": "{{relname}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 6, "type": "timeseries", "title": "Downloads Table Growth", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20}, "targets": [{"expr": "pg_stat_user_tables_n_live_tup{relname=\"downloads\"}", "legendFormat": "downloads rows", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 7, "type": "timeseries", "title": "Users Table Growth", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20}, "targets": [{"expr": "pg_stat_user_tables_n_live_tup{relname=\"users\"}", "legendFormat": "users rows", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 8, "type": "timeseries", "title": "Failed Downloads Over Time", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 28}, "targets": [{"expr": "sum by (platform) (rate(saveinator_ytdlp_errors_total[$__rate_interval]) * 60)", "legendFormat": "{{platform}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 9, "type": "logs", "title": "Migration Health", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 28}, "targets": [{"expr": "{container=~\"saveinator.*\"} |~ \"alembic|migration|upgrade|revision\"", "refId": "A", "datasource": {"type": "loki", "uid": "loki"}}], "options": {"showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending"}},
    {"id": 10, "type": "timeseries", "title": "Database Disk Usage", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 28}, "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}, "targets": [{"expr": "pg_database_size_bytes", "legendFormat": "{{datname}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 11, "type": "stat", "title": "Redis Availability", "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}, "targets": [{"expr": "redis_up", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 12, "type": "timeseries", "title": "Redis Memory Usage", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 36}, "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}, "targets": [{"expr": "redis_memory_used_bytes", "legendFormat": "used", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 13, "type": "timeseries", "title": "Redis Keys", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 36}, "targets": [{"expr": "redis_db_keys", "legendFormat": "{{db}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 14, "type": "timeseries", "title": "Expired Keys", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 44}, "targets": [{"expr": "rate(redis_expired_keys_total[$__rate_interval])", "legendFormat": "expired/s", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 15, "type": "timeseries", "title": "Evicted Keys", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 44}, "targets": [{"expr": "rate(redis_evicted_keys_total[$__rate_interval])", "legendFormat": "evicted/s", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 16, "type": "timeseries", "title": "Command Rate", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 44}, "targets": [{"expr": "rate(redis_commands_processed_total[$__rate_interval])", "legendFormat": "commands/s", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 17, "type": "logs", "title": "User Queue Locks", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 52}, "targets": [{"expr": "{container=~\"saveinator.*\"} |~ \"user_queue|lock|already has an active\"", "refId": "A", "datasource": {"type": "loki", "uid": "loki"}}], "options": {"showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending"}},
    {"id": 18, "type": "logs", "title": "YouTube Pending Sessions", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 52}, "targets": [{"expr": "{container=~\"saveinator.*\"} |~ \"youtube.*session|pending\"", "refId": "A", "datasource": {"type": "loki", "uid": "loki"}}], "options": {"showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending"}},
    {"id": 19, "type": "logs", "title": "Banned Users Set Size", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 52}, "targets": [{"expr": "{container=~\"saveinator.*\"} |~ \"banned_users|ban\"", "refId": "A", "datasource": {"type": "loki", "uid": "loki"}}], "options": {"showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending"}},
    {"id": 20, "type": "logs", "title": "Redis Errors", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 60}, "targets": [{"expr": "{container=~\"saveinator.*\"} |= \"redis\" |~ \"error|failed|exception|timeout\"", "refId": "A", "datasource": {"type": "loki", "uid": "loki"}}], "options": {"showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending"}}
  ]
}
