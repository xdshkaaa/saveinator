{
  "uid": "saveinator-overview",
  "title": "Saveinator Unified Monitoring",
  "tags": ["saveinator", "overview"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {"id": 1, "type": "stat", "title": "Bot Target", "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0}, "targets": [{"expr": "up{job=\"saveinator-bot\"}", "legendFormat": "bot", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 2, "type": "stat", "title": "Worker Target", "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0}, "targets": [{"expr": "up{job=\"saveinator-worker\"}", "legendFormat": "worker", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 3, "type": "stat", "title": "Active Chats", "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0}, "targets": [{"expr": "saveinator_active_chats", "legendFormat": "active chats", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 4, "type": "stat", "title": "New Users 24h", "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0}, "targets": [{"expr": "increase(saveinator_users_created_total[24h])", "legendFormat": "users", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 5, "type": "stat", "title": "Downloads 1h", "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0}, "targets": [{"expr": "sum(increase(saveinator_downloads_enqueued_total[1h]))", "legendFormat": "downloads", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 6, "type": "stat", "title": "RPC Failures 1h", "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0}, "targets": [{"expr": "increase(saveinator_telegram_api_failures_total[1h])", "legendFormat": "failures", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 7, "type": "timeseries", "title": "Downloads by Platform", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}, "targets": [{"expr": "sum by (platform) (rate(saveinator_downloads_enqueued_total[$__rate_interval]) * 60)", "legendFormat": "{{platform}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 8, "type": "timeseries", "title": "Download Duration p95", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}, "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le, platform) (rate(saveinator_download_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "{{platform}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 9, "type": "timeseries", "title": "Telegram RPC Requests", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}, "targets": [{"expr": "sum by (method, status) (rate(saveinator_telegram_api_requests_total[$__rate_interval]) * 60)", "legendFormat": "{{method}} {{status}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 10, "type": "timeseries", "title": "Telegram RPC Latency p95", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}, "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le, method) (rate(saveinator_telegram_api_latency_seconds_bucket[$__rate_interval])))", "legendFormat": "{{method}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 11, "type": "timeseries", "title": "HTTP Handlers by Route", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20}, "targets": [{"expr": "sum by (route, status) (rate(saveinator_http_requests_total[$__rate_interval]) * 60)", "legendFormat": "{{route}} {{status}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 12, "type": "timeseries", "title": "HTTP Handler Latency p95", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20}, "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le, route) (rate(saveinator_http_request_latency_seconds_bucket[$__rate_interval])))", "legendFormat": "{{route}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 13, "type": "timeseries", "title": "Users and Messages", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28}, "targets": [{"expr": "increase(saveinator_users_created_total[1h])", "legendFormat": "new users/hour", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}, {"expr": "increase(saveinator_messages_received_total[1h])", "legendFormat": "messages/hour", "refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 14, "type": "timeseries", "title": "Downloaded File Size p95", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28}, "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le, platform) (rate(saveinator_download_file_size_bytes_bucket[$__rate_interval])))", "legendFormat": "{{platform}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 15, "type": "timeseries", "title": "Failures by Source", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 36}, "targets": [{"expr": "sum by (source) (rate(saveinator_errors_total[$__rate_interval]) * 60)", "legendFormat": "{{source}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}, {"expr": "sum by (platform) (rate(saveinator_ytdlp_errors_total[$__rate_interval]) * 60)", "legendFormat": "download {{platform}}", "refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 16, "type": "timeseries", "title": "Celery Task Outcomes", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 36}, "targets": [{"expr": "sum by (task, status) (rate(saveinator_celery_tasks_total[$__rate_interval]) * 60)", "legendFormat": "{{task}} {{status}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]}
  ]
}
