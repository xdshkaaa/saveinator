{
  "uid": "saveinator-operations",
  "title": "Saveinator Operations",
  "tags": ["saveinator", "operations"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {"id": 1, "type": "stat", "title": "Bot Uptime", "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}, "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "targets": [{"expr": "saveinator_uptime_seconds", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 2, "type": "stat", "title": "Active Chats", "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}, "targets": [{"expr": "saveinator_active_chats", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 3, "type": "stat", "title": "Webhook Health", "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}, "targets": [{"expr": "up{job=\"saveinator-bot\"}", "legendFormat": "bot metrics target", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 4, "type": "stat", "title": "Telegram API Failures", "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}, "targets": [{"expr": "increase(saveinator_telegram_api_failures_total[15m])", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 5, "type": "timeseries", "title": "Incoming Messages", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}, "targets": [{"expr": "rate(saveinator_messages_received_total[$__rate_interval]) * 60", "legendFormat": "messages/min", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 6, "type": "timeseries", "title": "Commands per Minute", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}, "targets": [{"expr": "sum(rate(saveinator_commands_handled_total[$__rate_interval])) * 60", "legendFormat": "commands/min", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 7, "type": "bargauge", "title": "Commands by Type", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}, "targets": [{"expr": "topk(15, sum by (command) (increase(saveinator_commands_handled_total[$__range])))", "legendFormat": "{{command}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 8, "type": "timeseries", "title": "Telegram API Latency p95", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}, "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le, method) (rate(saveinator_telegram_api_latency_seconds_bucket[$__rate_interval])))", "legendFormat": "{{method}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 9, "type": "timeseries", "title": "Telegram API Requests", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20}, "targets": [{"expr": "sum by (method, status) (rate(saveinator_telegram_api_requests_total[$__rate_interval]) * 60)", "legendFormat": "{{method}} {{status}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 10, "type": "timeseries", "title": "Error Rate", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20}, "targets": [{"expr": "sum by (source) (rate(saveinator_errors_total[$__rate_interval]) * 60)", "legendFormat": "{{source}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 11, "type": "logs", "title": "Private vs Group Messages", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28}, "targets": [{"expr": "{service=~\"bot|webhook\", container=~\"saveinator.*\"} |~ \"private|group|supergroup\"", "refId": "A", "datasource": {"type": "loki", "uid": "loki"}}], "options": {"showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending"}},
    {"id": 12, "type": "timeseries", "title": "Messages per Minute", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28}, "targets": [{"expr": "rate(saveinator_messages_received_total[$__rate_interval]) * 60", "legendFormat": "messages/min", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]}
  ]
}
