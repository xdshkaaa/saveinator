{
  "uid": "saveinator-bots",
  "title": "Telegram Bots",
  "tags": ["saveinator", "telegram"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Bot Uptime (s)",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "saveinator_uptime_seconds", "refId": "A"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active Chats",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "saveinator_active_chats", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Messages / min",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {
          "expr": "rate(saveinator_messages_received_total[5m]) * 60",
          "legendFormat": "messages/min",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Errors / min",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {
          "expr": "rate(saveinator_errors_total[5m]) * 60",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Telegram API latency p95",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(saveinator_telegram_api_latency_seconds_bucket[5m])) by (le, method))",
          "legendFormat": "{{method}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Telegram API failures / min",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [
        {
          "expr": "rate(saveinator_telegram_api_failures_total[5m]) * 60",
          "legendFormat": "failures/min",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Downloads enqueued / min",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "targets": [
        {
          "expr": "rate(saveinator_downloads_enqueued_total[5m]) * 60",
          "legendFormat": "{{platform}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Celery tasks / min",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "targets": [
        {
          "expr": "rate(saveinator_celery_tasks_total[5m]) * 60",
          "legendFormat": "{{task}} {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Rate limit drops / min",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
      "targets": [
        {
          "expr": "rate(saveinator_rate_limit_dropped_total[5m]) * 60",
          "legendFormat": "{{scope}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "yt-dlp errors / min",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
      "targets": [
        {
          "expr": "rate(saveinator_ytdlp_errors_total[5m]) * 60",
          "legendFormat": "{{platform}}",
          "refId": "A"
        }
      ]
    }
  ]
}
