{
  "title": "Bot Fleet (botd)",
  "uid": "saveinator-bot-fleet",
  "tags": ["saveinator", "fleet"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "bot",
        "label": "Bot",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(saveinator_bot_updates_total, bot)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "botd Up",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "up{job=\"saveinator-botd\"}",
          "legendFormat": "botd",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Updates 1h (fleet)",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(saveinator_bot_updates_total{bot=~\"$bot\"}[1h]))",
          "legendFormat": "updates",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Downloads Enqueued 1h",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(saveinator_bot_downloads_enqueued_total{bot=~\"$bot\"}[1h]))",
          "legendFormat": "downloads",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Task Failures 1h",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 } ] }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(saveinator_bot_tasks_total{status=\"FAILURE\",bot=~\"$bot\"}[1h]))",
          "legendFormat": "failures",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Task Success Rate 1h",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "green", "value": 0.9 } ] }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(saveinator_bot_tasks_total{status=\"SUCCESS\",bot=~\"$bot\"}[1h])) / clamp_min(sum(increase(saveinator_bot_tasks_total{bot=~\"$bot\"}[1h])), 1)",
          "legendFormat": "success",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Active Users (30m)",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [
        {
          "expr": "max(saveinator_active_users{job=\"saveinator-botd\"})",
          "legendFormat": "active",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Updates / min by Bot",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (bot) (rate(saveinator_bot_updates_total{bot=~\"$bot\"}[5m])) * 60",
          "legendFormat": "{{bot}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Downloads Enqueued / min by Bot & Platform",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum by (bot, platform) (rate(saveinator_bot_downloads_enqueued_total{bot=~\"$bot\"}[5m])) * 60",
          "legendFormat": "{{bot}} / {{platform}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Worker Tasks / min by Bot & Status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum by (bot, status) (rate(saveinator_bot_tasks_total{bot=~\"$bot\"}[5m])) * 60",
          "legendFormat": "{{bot}} / {{status}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Task Duration p95 by Bot",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (bot, le) (rate(saveinator_bot_task_duration_seconds_bucket{bot=~\"$bot\"}[10m])))",
          "legendFormat": "{{bot}} p95",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "expr": "histogram_quantile(0.50, sum by (bot, le) (rate(saveinator_bot_task_duration_seconds_bucket{bot=~\"$bot\"}[10m])))",
          "legendFormat": "{{bot}} p50",
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Task Failure Ratio by Bot (10m)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.3 } ] }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (bot) (rate(saveinator_bot_tasks_total{status=\"FAILURE\",bot=~\"$bot\"}[10m])) / clamp_min(sum by (bot) (rate(saveinator_bot_tasks_total{bot=~\"$bot\"}[10m])), 0.001)",
          "legendFormat": "{{bot}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Telegram API Failures / min (botd)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "sum(rate(saveinator_telegram_api_failures_total{job=\"saveinator-botd\"}[5m])) * 60",
          "legendFormat": "api failures",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "expr": "sum by (source) (rate(saveinator_errors_total{job=\"saveinator-botd\"}[5m])) * 60",
          "legendFormat": "errors: {{source}}",
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 16,
      "type": "bargauge",
      "title": "Updates 24h by Bot",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "sum by (bot) (increase(saveinator_bot_updates_total{bot=~\"$bot\"}[24h]))",
          "legendFormat": "{{bot}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 17,
      "type": "bargauge",
      "title": "Downloads 24h by Bot",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "sum by (bot) (increase(saveinator_bot_downloads_enqueued_total{bot=~\"$bot\"}[24h]))",
          "legendFormat": "{{bot}}",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    }
  ]
}
