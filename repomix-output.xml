<file path="monitoring/grafana/dashboards/downloads.json">
{
  "uid": "saveinator-downloads",
  "title": "Download Operations",
  "tags": ["saveinator", "downloads"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Downloads Enqueued by Platform", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"expr": "sum by (platform) (rate(saveinator_downloads_enqueued_total[$__rate_interval]) * 60)", "legendFormat": "{{platform}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 2, "type": "timeseries", "title": "Successful Downloads", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "targets": [{"expr": "sum(rate(saveinator_celery_tasks_total{task=~\"workers\\\\.(tasks|pinterest_task)\\\\..*\",status=\"SUCCESS\"}[$__rate_interval]) * 60)", "legendFormat": "completed/min", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 3, "type": "timeseries", "title": "Failed Downloads", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "targets": [{"expr": "sum by (platform) (rate(saveinator_ytdlp_errors_total[$__rate_interval]) * 60)", "legendFormat": "{{platform}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 4, "type": "timeseries", "title": "Failure Rate by Platform", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}, "targets": [{"expr": "sum by (platform) (rate(saveinator_ytdlp_errors_total[$__rate_interval])) / clamp_min(sum by (platform) (rate(saveinator_downloads_enqueued_total[$__rate_interval])), 0.001)", "legendFormat": "{{platform}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 5, "type": "timeseries", "title": "Average Download Duration", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}, "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}, "targets": [{"expr": "sum by (platform) (rate(saveinator_download_duration_seconds_sum[$__rate_interval])) / clamp_min(sum by (platform) (rate(saveinator_download_duration_seconds_count[$__rate_interval])), 0.001)", "legendFormat": "{{platform}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 6, "type": "heatmap", "title": "Downloaded File Size Distribution", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}, "targets": [{"expr": "sum by (le) (rate(saveinator_download_file_size_bytes_bucket[$__rate_interval]))", "legendFormat": "{{le}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 7, "type": "logs", "title": "Too-Large File Errors", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 24}, "targets": [{"expr": "{container=~\"saveinator.*\"} |~ \"too_large|larger than|send limit\"", "refId": "A", "datasource": {"type": "loki", "uid": "loki"}}], "options": {"showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending"}},
    {"id": 8, "type": "logs", "title": "Timeout Errors", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 24}, "targets": [{"expr": "{container=~\"saveinator.*\"} |~ \"timed out|timeout|exceeded\"", "refId": "A", "datasource": {"type": "loki", "uid": "loki"}}], "options": {"showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending"}},
    {"id": 9, "type": "timeseries", "title": "yt-dlp Errors", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 24}, "targets": [{"expr": "sum by (platform) (rate(saveinator_ytdlp_errors_total[$__rate_interval]) * 60)", "legendFormat": "{{platform}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 10, "type": "logs", "title": "Pinterest Errors", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 32}, "targets": [{"expr": "{container=~\"saveinator.*\"} |= \"pinterest\" |~ \"error|failed|exception\"", "refId": "A", "datasource": {"type": "loki", "uid": "loki"}}], "options": {"showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending"}},
    {"id": 11, "type": "timeseries", "title": "Spotify Processing Stats", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 32}, "targets": [{"expr": "rate(saveinator_spotify_requests_total[$__rate_interval]) * 60", "legendFormat": "spotify/min", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 13, "type": "timeseries", "title": "SoundCloud Processing Stats", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 40}, "targets": [{"expr": "rate(saveinator_soundcloud_requests_total[$__rate_interval]) * 60", "legendFormat": "requests/min", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}, {"expr": "rate(saveinator_soundcloud_downloads_success_total[$__rate_interval]) * 60", "legendFormat": "downloads/min", "refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"}}, {"expr": "rate(saveinator_soundcloud_metadata_failures_total[$__rate_interval]) * 60", "legendFormat": "metadata failures/min", "refId": "C", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 12, "type": "bargauge", "title": "Top Failing Platforms", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 32}, "targets": [{"expr": "topk(10, sum by (platform) (increase(saveinator_ytdlp_errors_total[$__range])))", "legendFormat": "{{platform}}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}}]}
  ]
}
</file>

