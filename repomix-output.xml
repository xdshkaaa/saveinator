<file path="docker-compose.yml">
services:
  db:
    image: postgres:16-alpine
    environment:
      POSTGRES_DB: saveinator
      POSTGRES_USER: saveinator
      POSTGRES_PASSWORD: ${DB_PASSWORD:-changeme}
    volumes:
      - pgdata:/var/lib/postgresql/data
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U saveinator"]
      interval: 10s
      timeout: 5s
      retries: 5

  redis:
    image: redis:7-alpine
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5

  bot:
    build:
      context: .
      dockerfile: docker/webhook/Dockerfile
    environment:
      BOT_TOKEN: ${BOT_TOKEN}
      DATABASE_URL: postgresql+asyncpg://saveinator:${DB_PASSWORD:-changeme}@db:5432/saveinator
      REDIS_URL: redis://redis:6379/0
      CELERY_BROKER_URL: redis://redis:6379/0
      CELERY_RESULT_BACKEND: redis://redis:6379/0
      USE_POLLING: "${USE_POLLING:-false}"
      WEBHOOK_HOST: "${WEBHOOK_HOST:-https://saveinator-hooks.xdshka.party}"
      WEBHOOK_PATH: "${WEBHOOK_PATH:-/webhook}"
      WEBHOOK_PORT: "${WEBHOOK_PORT:-8000}"
      WEBHOOK_LISTEN: "${WEBHOOK_LISTEN:-0.0.0.0}"
      WEBHOOK_SECRET_TOKEN: "${WEBHOOK_SECRET_TOKEN:-}"
      LOG_LEVEL: ${LOG_LEVEL:-INFO}
      SPOTIFY_ENABLED: ${SPOTIFY_ENABLED:-false}
      SPOTIFY_CLIENT_ID: ${SPOTIFY_CLIENT_ID:-}
      SPOTIFY_CLIENT_SECRET: ${SPOTIFY_CLIENT_SECRET:-}
      SPOTIFY_API_TIMEOUT_SECONDS: ${SPOTIFY_API_TIMEOUT_SECONDS:-15}
      SPOTIFY_DOWNLOAD_ENABLED: ${SPOTIFY_DOWNLOAD_ENABLED:-true}
      SPOTIFY_TRACK_TIMEOUT_SECONDS: ${SPOTIFY_TRACK_TIMEOUT_SECONDS:-60}
      SPOTIFY_DL_OUTPUT_FORMAT: ${SPOTIFY_DL_OUTPUT_FORMAT:-mp3}
      SPOTIFY_DOWNLOAD_CONCURRENCY: ${SPOTIFY_DOWNLOAD_CONCURRENCY:-2}
      SPOTIFY_META_CACHE_TTL_SECONDS: ${SPOTIFY_META_CACHE_TTL_SECONDS:-3600}
      YOUTUBE_SEARCH_CACHE_TTL_SECONDS: ${YOUTUBE_SEARCH_CACHE_TTL_SECONDS:-604800}
      SOUNDCLOUD_ENABLED: ${SOUNDCLOUD_ENABLED:-true}
      SOUNDCLOUD_DOWNLOAD_ENABLED: ${SOUNDCLOUD_DOWNLOAD_ENABLED:-false}
      SOUNDCLOUD_TRACK_TIMEOUT_SECONDS: ${SOUNDCLOUD_TRACK_TIMEOUT_SECONDS:-30}
      SOUNDCLOUD_MAX_TRACKS: ${SOUNDCLOUD_MAX_TRACKS:-20}
      SOUNDCLOUD_DL_OUTPUT_FORMAT: ${SOUNDCLOUD_DL_OUTPUT_FORMAT:-mp3}
      SOUNDCLOUD_MAX_FILE_MB: ${SOUNDCLOUD_MAX_FILE_MB:-50}
      SOUNDCLOUD_META_CACHE_TTL_SECONDS: ${SOUNDCLOUD_META_CACHE_TTL_SECONDS:-3600}
      PINTEREST_ENABLED: ${PINTEREST_ENABLED:-true}
      PINTEREST_TIMEOUT_SECONDS: ${PINTEREST_TIMEOUT_SECONDS:-30}
      PINTEREST_MAX_ITEMS: ${PINTEREST_MAX_ITEMS:-10}
      METRICS_ENABLED: ${METRICS_ENABLED:-true}
      METRICS_PORT: "9101"
    ports:
      - "127.0.0.1:8000:8000"
      - "127.0.0.1:9101:9101"
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
    restart: unless-stopped

  worker:
    build:
      context: .
      dockerfile: docker/worker/Dockerfile
    command: ["celery", "-A", "workers.app", "worker", "--loglevel=info", "-B", "-c", "1", "--max-tasks-per-child=1"]
    environment:
      BOT_TOKEN: ${BOT_TOKEN}
      DATABASE_URL: postgresql+asyncpg://saveinator:${DB_PASSWORD:-changeme}@db:5432/saveinator
      REDIS_URL: redis://redis:6379/0
      CELERY_BROKER_URL: redis://redis:6379/0
      CELERY_RESULT_BACKEND: redis://redis:6379/0
      LOG_LEVEL: ${LOG_LEVEL:-INFO}
      PINTEREST_ENABLED: ${PINTEREST_ENABLED:-true}
      PINTEREST_TIMEOUT_SECONDS: ${PINTEREST_TIMEOUT_SECONDS:-30}
      PINTEREST_MAX_ITEMS: ${PINTEREST_MAX_ITEMS:-10}
      DOWNLOAD_TIMEOUT_SECONDS: ${DOWNLOAD_TIMEOUT_SECONDS:-60}
      SEND_VIDEO_LIMIT_MB: ${SEND_VIDEO_LIMIT_MB:-50}
      SEND_DOCUMENT_LIMIT_MB: ${SEND_DOCUMENT_LIMIT_MB:-1999}
      YOUTUBE_MAX_FILE_SIZE_MB: ${YOUTUBE_MAX_FILE_SIZE_MB:-1999}
      YOUTUBE_DOWNLOAD_TIMEOUT_SECONDS: ${YOUTUBE_DOWNLOAD_TIMEOUT_SECONDS:-600}
      METRICS_ENABLED: ${METRICS_ENABLED:-true}
      WORKER_METRICS_PORT: "9102"
      PROMETHEUS_MULTIPROC_DIR: /tmp/prometheus_multiproc
    ports:
      - "127.0.0.1:9102:9102"
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
    restart: unless-stopped

volumes:
  pgdata:
</file>

